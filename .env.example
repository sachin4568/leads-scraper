# ==============================================================================
# LEAD INTELLIGENCE SYSTEM — ENVIRONMENT TEMPLATE (.env.example)
# Copy this file to .env and fill in your production credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. GENERAL APPLICATION & ENVIRONMENT
# ------------------------------------------------------------------------------
APP_ENV=local
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/lead_db
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
JWT_SECRET=replace-with-a-local-development-secret-key-32-bytes-long

# ------------------------------------------------------------------------------
# 2. MULTI-PROVIDER LEAD SOURCES (API KEYS)
# ------------------------------------------------------------------------------

# Google Places API (New) Key
GOOGLE_MAPS_API_KEY=your_google_places_api_key_here
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# Foursquare Places API Key (v3)
FOURSQUARE_API_KEY=your_foursquare_api_key_here

# Data Axle Business API Key & Base URL
DATA_AXLE_API_KEY=your_data_axle_api_key_here
DATA_AXLE_BASE_URL=https://api.data-axle.com/v1/places

# Yelp Fusion API Key
YELP_API_KEY=your_yelp_api_key_here

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SINGLE SIGN-ON (SSO)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret_here

# ------------------------------------------------------------------------------
# 4. MONITORING & CLOUD SECRETS MANAGER (OPTIONAL)
# ------------------------------------------------------------------------------
SENTRY_DSN=your_sentry_dsn_here
AWS_REGION=ap-south-1
SECRETS_MANAGER_SECRET_ID=
